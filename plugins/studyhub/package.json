{
  "name": "dsh-studyhub",
  "version": "0.1.0",
  "description": "StudyHub 学习台：把本机的 agent 学习平台（Python · 127.0.0.1:8777）接进 DeepSeek Harness —— 左栏图标 + 主面板 iframe + 服务生命周期",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": { "default": "./index.js" },
    "./client": { "default": "./client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "engines": { "dsh": ">=0.2.0" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "study", "learning"],
  "license": "MIT"
}
